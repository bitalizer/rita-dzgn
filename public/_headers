# Response headers for the static site, applied by Cloudflare (Workers static assets).
# Responses from the worker itself (/api/*) set their own headers in worker/src/index.ts.
#
# The CSP has no script-src: the inline scripts Next.js emits and the tools Cloudflare adds (Zaraz, the Web Analytics beacon)
# would need 'unsafe-inline', which protects nothing. Its directives block framing, <base> hijacking, plugins and
# form posts to other sites.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Caching. HTML keeps Cloudflare's default (always revalidate), so a deploy is live at once.
# Build output is content-hashed: safe to keep for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their file name when re-exported, so a week, then refresh in the background.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og/*
  Cache-Control: public, max-age=86400
