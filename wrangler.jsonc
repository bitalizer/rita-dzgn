// One Worker serves the whole site: the static Next export from ./out plus POST /api/contact.
// Static files never run worker code (free, unlimited); only /api/* does (free tier: 100k requests/day).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rita-dzgn",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "ritadzgn.com", "custom_domain": true }, { "pattern": "www.ritadzgn.com", "custom_domain": true }],
  // Site only on the custom domain; branch builds still get preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true }
  // Secrets (never commit): npx wrangler secret put TELEGRAM_BOT_TOKEN · npx wrangler secret put TELEGRAM_CHAT_ID
}
